# Tiger Cloud (TimescaleDB) connection string, from the Tiger Cloud console
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Snowflake Cortex. Account URL like https://ab12345.us-west-2.snowflakecomputing.com
# PAT: Snowsight -> user menu -> My profile -> Programmatic access tokens
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
# routing + per-label coherence monitor
JUDGE_MODEL=claude-haiku-4-5
# periodic batch audit (every AUDIT_EVERY_N_LABELS labels per worker)
AUDIT_MODEL=claude-sonnet-4-5
AUDIT_EVERY_N_LABELS=10
# items the first-pass model is at least this confident about are auto-labeled, never served
ROUTE_CONFIDENCE_THRESHOLD=0.85
# Set to 1 to run the judge without Snowflake (gold-label + heuristic verdicts)
JUDGE_MOCK=0

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Treasury secret: base58 string OR the JSON byte array from `solana-keygen new -o treasury.json`
TREASURY_SECRET_KEY=
# 0.001 SOL base pay per approved label
BASE_PAY_LAMPORTS=1000000
# 70% of each payout goes to the wallet instantly; 30% vests in a per-worker on-chain escrow
INSTANT_PAY_PCT=70
# Vesting hold before escrow releases (slashed instead if the worker is paused or misses a gold check)
ESCROW_HOLD_SECONDS=90

# 32+ random chars for the session cookie
SESSION_SECRET=
# Set to 1 only for local testing without a wallet extension (skips signature check)
ALLOW_INSECURE_LOGIN=0
